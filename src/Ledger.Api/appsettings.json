{
  "ConnectionStrings": {
    "Ledger": "Host=localhost;Port=5432;Database=ledger;Username=ledger;Password=ledger",
    "Redis": "localhost:6379"
  },
  "RabbitMq": { "Host": "localhost", "Port": 5672, "User": "guest", "Password": "guest", "Exchange": "ledger.events", "PollIntervalMs": 500, "BatchSize": 100 },
  "Outbox": { "PublisherEnabled": true },
  "Jwt": {
    "Issuer": "ledger-api",
    "Audience": "ledger-clients",
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789",
    "TokenLifetimeMinutes": 60,
    "DevTokenEndpoint": true
  },
  "RateLimiting": { "MoneyOpsPerMinute": 300 },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http": "Warning" } }
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*"
}
